[
  {
    "name": "Bonus - Conduit Uptime Monitor",
    "nodes": [
      {
        "parameters": {
          "rule": {
            "interval": [
              {
                "field": "minutes",
                "minutesInterval": 5
              }
            ]
          }
        },
        "id": "b41a1223-1101-4f34-84cf-38bc7d4fe501",
        "name": "Check Every 5 Minutes",
        "type": "n8n-nodes-base.scheduleTrigger",
        "typeVersion": 1.2,
        "position": [0, 200]
      },
      {
        "parameters": {
          "assignments": {
            "assignments": [
              {
                "id": "f66bcf4f-81aa-4891-a580-295caf7ad4b1",
                "name": "startedAt",
                "value": "={{ Date.now() }}",
                "type": "number"
              }
            ]
          },
          "options": {}
        },
        "id": "b41a1223-1101-4f34-84cf-38bc7d4fe502",
        "name": "Start Response Timer",
        "type": "n8n-nodes-base.set",
        "typeVersion": 3.4,
        "position": [240, 200]
      },
      {
        "parameters": {
          "url": "https://demo.realworld.show/",
          "options": {
            "response": {
              "response": {
                "fullResponse": true,
                "neverError": true,
                "responseFormat": "text"
              }
            },
            "timeout": 10000
          }
        },
        "id": "b41a1223-1101-4f34-84cf-38bc7d4fe503",
        "name": "Check Conduit Website",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.5,
        "position": [500, 200],
        "retryOnFail": true,
        "maxTries": 2,
        "waitBetweenTries": 1000,
        "onError": "continueErrorOutput"
      },
      {
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "const response = $input.first().json;\nconst statusCode = Number(response.statusCode ?? 0);\nconst startedAt = Number($('Start Response Timer').first().json.startedAt ?? Date.now());\nreturn [{ json: { url: 'https://demo.realworld.show/', statusCode, responseTimeMs: Math.max(0, Date.now() - startedAt), checkedAt: new Date().toISOString(), isUp: statusCode === 200, errorMessage: '' } }];"
        },
        "id": "b41a1223-1101-4f34-84cf-38bc7d4fe504",
        "name": "Read Status and Response Time",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [780, 120]
      },
      {
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "const failure = $input.first().json;\nconst startedAt = Number($('Start Response Timer').first().json.startedAt ?? Date.now());\nconst errorMessage = failure.error?.message || failure.message || 'Request failed after retry';\nreturn [{ json: { url: 'https://demo.realworld.show/', statusCode: Number(failure.statusCode ?? 0), responseTimeMs: Math.max(0, Date.now() - startedAt), checkedAt: new Date().toISOString(), isUp: false, errorMessage } }];"
        },
        "id": "b41a1223-1101-4f34-84cf-38bc7d4fe505",
        "name": "Prepare Request Failure",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [780, 360]
      },
      {
        "parameters": {
          "conditions": {
            "options": {
              "caseSensitive": true,
              "leftValue": "",
              "typeValidation": "strict",
              "version": 2
            },
            "conditions": [
              {
                "id": "e7e515f7-b704-44a3-84fc-b09a7f85f3ef",
                "leftValue": "={{ $json.isUp }}",
                "rightValue": true,
                "operator": {
                  "type": "boolean",
                  "operation": "equals"
                }
              }
            ],
            "combinator": "and"
          },
          "options": {}
        },
        "id": "b41a1223-1101-4f34-84cf-38bc7d4fe506",
        "name": "Is Website Healthy?",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2.2,
        "position": [1060, 200]
      },
      {
        "parameters": {
          "assignments": {
            "assignments": [
              {
                "id": "9075f7b7-d38e-46a6-a725-79c3dd242c58",
                "name": "fromEmail",
                "value": "alerts@example.com",
                "type": "string"
              },
              {
                "id": "35d45bcc-ddf3-473d-9d54-ad41d825fd04",
                "name": "toEmail",
                "value": "you@example.com",
                "type": "string"
              },
              {
                "id": "b83db38f-a701-4b1d-9a57-3c451500f690",
                "name": "subject",
                "value": "={{ 'Uptime Alert: Conduit returned ' + ($json.statusCode || 'no response') }}",
                "type": "string"
              },
              {
                "id": "1edc7a83-04b4-4bfe-b1ac-c191f54670fd",
                "name": "message",
                "value": "={{ 'The Conduit demo did not return HTTP 200.\\n\\nURL: ' + $json.url + '\\nStatus: ' + ($json.statusCode || 'No response') + '\\nResponse time: ' + $json.responseTimeMs + ' ms\\nChecked: ' + $json.checkedAt + '\\nDetails: ' + ($json.errorMessage || 'Unexpected HTTP status') }}",
                "type": "string"
              }
            ]
          },
          "options": {}
        },
        "id": "b41a1223-1101-4f34-84cf-38bc7d4fe507",
        "name": "Compose Email Alert",
        "type": "n8n-nodes-base.set",
        "typeVersion": 3.4,
        "position": [1320, 320]
      },
      {
        "parameters": {
          "operation": "send",
          "resource": "email",
          "fromEmail": "={{ $json.fromEmail }}",
          "toEmail": "={{ $json.toEmail }}",
          "subject": "={{ $json.subject }}",
          "emailFormat": "text",
          "text": "={{ $json.message }}",
          "options": {
            "appendAttribution": false
          }
        },
        "id": "b41a1223-1101-4f34-84cf-38bc7d4fe508",
        "name": "Send Uptime Alert Email",
        "type": "n8n-nodes-base.emailSend",
        "typeVersion": 2.1,
        "position": [1580, 320]
      },
      {
        "parameters": {
          "content": "## Conduit Uptime Monitor\nRuns every 5 minutes against the Task 1 demo. A healthy check is HTTP 200. Non-200 responses and request failures reach the alert branch.\n\nBefore activation: configure the email node with your saved SMTP credential and replace the example sender and recipient addresses.",
          "height": 220,
          "width": 420,
          "color": 5
        },
        "id": "b41a1223-1101-4f34-84cf-38bc7d4fe509",
        "name": "Setup Notes",
        "type": "n8n-nodes-base.stickyNote",
        "typeVersion": 1,
        "position": [-20, -100]
      }
    ],
    "connections": {
      "Check Every 5 Minutes": {
        "main": [[{"node": "Start Response Timer", "type": "main", "index": 0}]]
      },
      "Start Response Timer": {
        "main": [[{"node": "Check Conduit Website", "type": "main", "index": 0}]]
      },
      "Check Conduit Website": {
        "main": [
          [{"node": "Read Status and Response Time", "type": "main", "index": 0}],
          [{"node": "Prepare Request Failure", "type": "main", "index": 0}]
        ]
      },
      "Read Status and Response Time": {
        "main": [[{"node": "Is Website Healthy?", "type": "main", "index": 0}]]
      },
      "Prepare Request Failure": {
        "main": [[{"node": "Is Website Healthy?", "type": "main", "index": 0}]]
      },
      "Is Website Healthy?": {
        "main": [[], [{"node": "Compose Email Alert", "type": "main", "index": 0}]]
      },
      "Compose Email Alert": {
        "main": [[{"node": "Send Uptime Alert Email", "type": "main", "index": 0}]]
      }
    },
    "active": false,
    "settings": {
      "executionOrder": "v1"
    },
    "versionId": "73bdc0e6-e248-4b23-9f32-6deedb406dfa",
    "meta": {
      "templateCredsSetupCompleted": false
    },
    "tags": []
  }
]
