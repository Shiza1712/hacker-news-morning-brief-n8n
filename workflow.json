          "jsCode": "const failures = $input.all().map((item) => item.json);\nconst details = failures.map((failure) => failure.error?.message || failure.message || failure.description || JSON.stringify(failure)).join(' | ');\nreturn [{ json: { logged: true, failureCount: failures.length, apiError: details.slice(0, 1500), message: `Morning Brief API failure: ${details.slice(0, 1500)}` } }];"
