        "id": "1dd5a3ff-6261-4334-9d84-190fde057e46",
        "name": "Fetch HN Front Page",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.5,
        "position": [
          260,
          80
        ],
        "onError": "continueErrorOutput"
      },
      {
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "const response = $input.first().json;\nconst hits = Array.isArray(response.hits) ? response.hits : [];\nconst stories = hits.map((hit) => {\n  const id = String(hit.objectID ?? '');\n  return {\n    id,\n    title: hit.title || hit.story_title || '(untitled)',\n    points: Number(hit.points ?? 0),\n    author: hit.author || 'unknown',\n    url: hit.url || `https://news.ycombinator.com/item?id=${id}`,\n    createdAt: hit.created_at || '',\n    comments: Number(hit.num_comments ?? 0),\n  };\n}).filter((story) => story.id && story.title)\n  .sort((a, b) => b.points - a.points)\n  .slice(0, 5);\nif (stories.length === 0) throw new Error('The Hacker News front-page search returned no stories.');\nreturn stories.map((story) => ({ json: story }));"
        },
        "id": "61992ee6-0445-41d7-9282-c370ea1709cb",
        "name": "Sort and Keep Top 5",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          500,
          80
        ],
        "onError": "continueErrorOutput"
      },
      {
        "parameters": {
          "method": "GET",
          "url": "={{ 'https://hacker-news.firebaseio.com/v0/item/' + $json.id + '.json' }}",
          "options": {
            "timeout": 15000,
            "response": {
              "response": {
                "responseFormat": "json"
              }
            }
          }
        },
        "id": "50c74c27-0318-4dfd-a580-d4d03e92ed9f",
        "name": "Enrich Top 5 with Item Details",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.5,
        "position": [
          760,
          80
        ],
        "onError": "continueErrorOutput"
      },
      {
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "const rows = $input.all().map((item) => item.json).filter((story) => story && story.id);\nif (rows.length === 0) throw new Error('No enriched Hacker News stories were available.');\nconst stories = rows.sort((a, b) => Number(b.score ?? 0) - Number(a.score ?? 0)).slice(0, 5).map((story) => ({\n  id: story.id,\n  title: story.title || '(untitled)',\n  points: Number(story.score ?? 0),\n  author: story.by || 'unknown',\n  comments: Number(story.descendants ?? 0),\n  url: story.url || `https://news.ycombinator.com/item?id=${story.id}`,\n}));\nconst trigger = $('Webhook').first().json;\nconst body = trigger.body && typeof trigger.body === 'object' ? trigger.body : {};\nconst threshold = Number(body.threshold ?? 100);\nconst dryRun = body.dryRun === true || body.dryRun === 'true';\nconst topScore = stories[0].points;\nconst storyLines = stories.map((story, index) => `${index + 1}. ${story.title}\\n   ${story.points} points | ${story.comments} comments | by ${story.author}\\n   ${story.url}`);\nconst message = `Hacker News Morning Brief - Top 5 Front Page Stories\\n\\n${storyLines.join('\\n\\n')}`;\nreturn [{ json: { stories, topScore, threshold, dryRun, message } }];"
        },
        "id": "2d1a8604-408f-4984-bd8a-a6bb6f02f2db",
        "name": "Build Digest and Test Settings",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1010,
